@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="app-layout">
    <!-- Top Compact Header Bar -->
    <header class="app-header-bar">
        <div class="header-container">
            <div class="d-flex align-items-center gap-3">
                <a href="/" class="brand-logo">
                    <span class="logo-icon">⚡</span>
                    <span class="logo-text">Personalization<span class="text-cyan">Portal</span></span>
                </a>
                <span class="badge bg-glass-neon text-cyan text-uppercase tracking-wide px-2 py-0.5 rounded-pill font-mono text-xs d-none d-md-inline-block">Dondlinger SaaS Engine</span>
            </div>

            <nav class="desktop-nav">
                <NavLink href="" Match="NavLinkMatch.All" class="nav-item-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    <span>Control Panel</span>
                </NavLink>
                <NavLink href="scraper" class="nav-item-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
                    <span>Inference Scraper</span>
                </NavLink>
            </nav>

            <div class="header-actions d-flex align-items-center gap-2">
                <a href="https://inspectallamado.dondlingergc.com" target="_blank" class="waz-link-btn font-mono text-xs py-1 px-3" title="Launch Inspect Llamado">
                    <span>Inspect Llamado ↗</span>
                </a>
                <a href="https://wazweather.dondlingergc.com" target="_blank" class="waz-link-btn font-mono text-xs py-1 px-3" title="Launch WaZWeather">
                    <span>WaZWeather ↗</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content Viewport -->
    <main class="app-main-viewport">
        @Body
    </main>

    <!-- Mobile Touch-Optimized Bottom Navigation Bar -->
    <nav class="mobile-bottom-bar">
        <NavLink href="" Match="NavLinkMatch.All" class="mobile-tab-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span>Dashboard</span>
        </NavLink>
        <NavLink href="scraper" class="mobile-tab-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 014-10z"/></svg>
            <span>AI Scraper</span>
        </NavLink>
    </nav>
</div>
