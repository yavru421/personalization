@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="app-layout">
    <!-- Top Mobile-Friendly Header -->
    <header class="app-header-bar">
        <div class="header-container">
            <a href="/" class="brand-logo">
                <span class="logo-icon">⚡</span>
                <span class="logo-text">Personalization<span class="text-cyan">Portal</span></span>
            </a>

            <nav class="desktop-nav">
                <NavLink href="" Match="NavLinkMatch.All" class="nav-item-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    <span>Control Panel</span>
                </NavLink>
                <NavLink href="scraper" class="nav-item-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
                    <span>Inference Scraper</span>
                </NavLink>
            </nav>

            <div class="header-actions">
                <a href="https://wazweather.dondlingergc.com" target="_blank" class="waz-link-btn" title="Launch WaZWeather">
                    <span>WaZWeather ↗</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="app-main-viewport">
        @Body
    </main>

    <!-- Mobile Touch-Optimized Bottom Navigation Bar -->
    <nav class="mobile-bottom-bar">
        <NavLink href="" Match="NavLinkMatch.All" class="mobile-tab-item">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span>Dashboard</span>
        </NavLink>
        <NavLink href="scraper" class="mobile-tab-item">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
            <span>AI Scraper</span>
        </NavLink>
    </nav>
</div>
