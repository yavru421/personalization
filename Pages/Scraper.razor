@page "/scraper"

<div class="dashboard-wrapper">
    <div class="glass-bg-glow"></div>

    <div class="container-fluid py-2 px-3 px-md-4 position-relative d-flex flex-column h-100" style="z-index: 1;">
        <!-- Compact Header -->
        <div class="d-flex align-items-center justify-content-between gap-2 mb-2 pb-2 border-bottom-glass flex-shrink-0">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-glass-neon text-cyan text-uppercase font-mono text-xs px-2.5 py-1 rounded-pill">Edge AI Inference Router</span>
                <span class="badge bg-dark-glass text-muted-cyan border-glass px-2.5 py-1 rounded-pill font-mono text-xs d-none d-sm-inline-block">50 Credits / Eval</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <div class="status-indicator-pill px-2.5 py-1 rounded-pill d-flex align-items-center gap-1.5 bg-glass-dark border-glass">
                    <span class="pulse-dot green"></span>
                    <span class="text-xs font-mono text-cyan">
                        Llama 3.3 70B Edge
                    </span>
                </div>

                <a href="/" class="btn btn-xs btn-outline-info border-glass rounded-pill px-2.5 py-1 text-cyan text-decoration-none font-mono text-xs">
                    ← Control Panel
                </a>
            </div>
        </div>

        <!-- Scraper Workspace Grid -->
        <div class="row g-3 flex-grow-1 overflow-auto py-1">
            <!-- Left Column: Controls & Configuration -->
            <div class="col-12 col-lg-5 d-flex flex-column">
                <div class="glass-card p-3 d-flex flex-column gap-2.5 flex-grow-1">
                    <h3 class="h6 text-white mb-0 d-flex align-items-center gap-2 font-mono text-uppercase tracking-wider">
                        ⚡ Target Configuration
                    </h3>

                    <!-- Target URL Input -->
                    <div>
                        <label class="form-label text-muted-cyan font-mono text-xs mb-1">TARGET URL</label>
                        <div class="input-glass-group">
                            <span class="input-icon">🔗</span>
                            <input type="url" class="form-control input-glass font-mono text-xs py-1.5" placeholder="https://example.com" @bind="targetUrl" />
                        </div>
                    </div>

                    <!-- Quick Preset Buttons -->
                    <div>
                        <label class="form-label text-muted-cyan font-mono text-xs mb-1">QUICK PRESETS</label>
                        <div class="d-flex flex-wrap gap-1.5">
                            <button type="button" class="btn btn-xs btn-outline-info border-glass rounded-pill text-xs font-mono text-white py-0.5 px-2" @onclick='() => targetUrl = "https://inspectallamado.dondlingergc.com"'>
                                Inspect Llamado
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-info border-glass rounded-pill text-xs font-mono text-white py-0.5 px-2" @onclick='() => targetUrl = "https://wazweather.dondlingergc.com"'>
                                WaZWeather
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-info border-glass rounded-pill text-xs font-mono text-white py-0.5 px-2" @onclick='() => targetUrl = "https://dondlingergc.com"'>
                                Dondlinger GC
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-info border-glass rounded-pill text-xs font-mono text-white py-0.5 px-2" @onclick='() => targetUrl = "https://news.ycombinator.com"'>
                                HackerNews
                            </button>
                        </div>
                    </div>

                    <!-- Mode Selection -->
                    <div>
                        <label class="form-label text-muted-cyan font-mono text-xs mb-1">INFERENCE MODE</label>
                        <select class="form-select select-glass font-mono text-xs py-1.5" @bind="inferenceMode">
                            <option value="architectural">Full Architectural & UX Audit</option>
                            <option value="summary">Executive Content Summary</option>
                            <option value="raw">Text Extraction & Scraping Only</option>
                        </select>
                    </div>

                    <!-- Execute Button -->
                    <button class="btn btn-cyan btn-glow w-100 py-2 rounded-3 font-mono text-xs d-flex align-items-center justify-content-center gap-2 mt-1" @onclick="ExecuteScraper" disabled="@isExecuting">
                        @if (isExecuting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Scraping & Synthesizing...</span>
                        }
                        else
                        {
                            <span>Execute Edge Scrape ⚡</span>
                        }
                    </button>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger-glass text-xs font-mono mb-0 py-1 px-2">
                            @errorMessage
                        </div>
                    }

                    <!-- History Log -->
                    <div class="mt-2 pt-2 border-top-glass flex-grow-1 overflow-auto" style="max-height: 180px;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted-cyan font-mono text-xs">RECENT SCRAPES</span>
                            @if (recentScrapes.Count > 0)
                            {
                                <button class="btn btn-xs text-danger-glass p-0 font-mono text-xs" @onclick="ClearHistory">Clear</button>
                            }
                        </div>

                        @if (recentScrapes.Count == 0)
                        {
                            <p class="text-muted-cyan text-xs italic mb-0">No recent evaluations recorded.</p>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-1">
                                @foreach (var item in recentScrapes)
                                {
                                    <div class="p-1.5 rounded bg-glass-dark border-glass d-flex justify-content-between align-items-center cursor-pointer hover-bright" @onclick="() => LoadFromHistory(item)">
                                        <div class="text-truncate me-2">
                                            <div class="text-white text-xs font-mono text-truncate">@item.Url</div>
                                            <div class="text-muted-cyan text-xxs font-mono">@item.Timestamp</div>
                                        </div>
                                        <span class="badge bg-glass-neon text-cyan text-xxs font-mono">Load</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Results & Viewer -->
            <div class="col-12 col-lg-7 d-flex flex-column">
                <div class="glass-card p-3 h-100 d-flex flex-column">
                    <!-- Results Toolbar -->
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom-glass flex-shrink-0">
                        <div class="d-flex gap-1.5">
                            <button class="btn btn-xs @(viewTab == "formatted" ? "btn-cyan" : "btn-outline-info border-glass text-muted-cyan") rounded-pill px-3 font-mono text-xs" @onclick='() => viewTab = "formatted"'>
                                Formatted Output
                            </button>
                            <button class="btn btn-xs @(viewTab == "raw" ? "btn-cyan" : "btn-outline-info border-glass text-muted-cyan") rounded-pill px-3 font-mono text-xs" @onclick='() => viewTab = "raw"'>
                                Raw Payload
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(scrapeResult))
                        {
                            <div class="d-flex gap-1.5">
                                <button class="btn btn-xs btn-outline-info border-glass rounded-pill px-2 py-0.5 text-cyan font-mono text-xs" @onclick="CopyToClipboard">
                                    📋 Copy
                                </button>
                                <button class="btn btn-xs btn-outline-info border-glass rounded-pill px-2 py-0.5 text-cyan font-mono text-xs" @onclick="DownloadResult">
                                    💾 Export
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Viewer Panel -->
                    <div class="flex-grow-1 p-3 rounded bg-glass-dark border-glass font-mono text-xs text-cyan-light overflow-auto" style="white-space: pre-wrap; max-height: 440px;">
                        @if (isExecuting)
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center h-100 py-4 gap-2">
                                <div class="spinner-modern"></div>
                                <span class="text-muted-cyan font-mono text-xs">Dispatching request to Cloudflare Edge AI Workers...</span>
                            </div>
                        }
                        else if (string.IsNullOrEmpty(scrapeResult))
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center h-100 py-4 text-center">
                                <span class="display-6 mb-2">⚡</span>
                                <p class="text-white font-mono text-sm mb-1">Inference Scraper Ready</p>
                                <p class="text-muted-cyan font-mono text-xs">Enter a target URL on the left and click "Execute Edge Scrape".</p>
                            </div>
                        }
                        else
                        {
                            if (viewTab == "formatted")
                            {
                                @scrapeResult
                            }
                            else
                            {
                                @rawJsonResponse
                            }
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(statusNotification))
                    {
                        <div class="mt-1 text-xs font-mono text-green text-center">
                            @statusNotification
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
