@page "/scraper"

<div class="dashboard-wrapper">
    <div class="glass-bg-glow"></div>

    <div class="container-fluid py-3 px-3 px-md-5 position-relative" style="z-index: 1;">
        <!-- Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4 pb-3 border-bottom-glass">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-glass-neon text-cyan text-uppercase tracking-wide px-3 py-1.5 rounded-pill font-mono text-xs">Edge AI Inference Router</span>
                    <span class="badge bg-dark-glass text-muted-cyan border-glass px-2.5 py-1 rounded-pill font-mono text-xs">50 Credits / Eval</span>
                </div>
                <h1 class="h3 font-weight-bold text-white mb-0">Inference <span class="text-cyan">Web Scraper</span></h1>
            </div>

            <div class="d-flex align-items-center gap-2 w-100 w-md-auto justify-content-between justify-content-md-end">
                <div class="status-indicator-pill px-3 py-1.5 rounded-pill d-flex align-items-center gap-2 bg-glass-dark border-glass">
                    <span class="pulse-dot green"></span>
                    <span class="text-xs font-mono text-cyan">
                        Llama 3.3 70B Fast Edge
                    </span>
                </div>

                <a href="/" class="btn btn-sm btn-outline-info border-glass rounded-pill px-3 text-cyan text-decoration-none font-mono text-xs">
                    ← Control Panel
                </a>
            </div>
        </div>

        <!-- Scraper Workspace Grid -->
        <div class="row g-4">
            <!-- Left Column: Controls & Configuration -->
            <div class="col-12 col-lg-5">
                <div class="glass-card p-4 d-flex flex-column gap-3">
                    <h3 class="h6 text-white mb-0 d-flex align-items-center gap-2 font-mono text-uppercase tracking-wider">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4 10 15.3 15.3 0 014-10z"/></svg>
                        Target Configuration
                    </h3>

                    <!-- Target URL Input -->
                    <div>
                        <label class="form-label text-muted-cyan font-mono text-xs">TARGET URL</label>
                        <div class="input-glass-group">
                            <span class="input-icon">🔗</span>
                            <input type="url" class="form-control input-glass font-mono text-sm" placeholder="https://example.com" @bind="targetUrl" />
                        </div>
                    </div>

                    <!-- Quick Preset Buttons -->
                    <div>
                        <label class="form-label text-muted-cyan font-mono text-xs mb-1.5">QUICK PRESETS</label>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-xs btn-outline-info border-glass rounded-pill text-xs font-mono text-white py-1 px-2.5" @onclick='() => targetUrl = "https://wazweather.dondlingergc.com"'>
                                WaZWeather
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-info border-glass rounded-pill text-xs font-mono text-white py-1 px-2.5" @onclick='() => targetUrl = "https://dondlingergc.com"'>
                                Dondlinger GC
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-info border-glass rounded-pill text-xs font-mono text-white py-1 px-2.5" @onclick='() => targetUrl = "https://news.ycombinator.com"'>
                                HackerNews
                            </button>
                        </div>
                    </div>

                    <!-- Mode Selection -->
                    <div>
                        <label class="form-label text-muted-cyan font-mono text-xs">INFERENCE MODE</label>
                        <select class="form-select select-glass font-mono text-xs" @bind="inferenceMode">
                            <option value="architectural">Full Architectural & UX Audit</option>
                            <option value="summary">Executive Content Summary</option>
                            <option value="raw">Text Extraction & Scraping Only</option>
                        </select>
                    </div>

                    <!-- Execute Button -->
                    <button class="btn btn-cyan btn-glow w-100 py-3 rounded-3 font-mono text-sm d-flex align-items-center justify-content-center gap-2 mt-2" @onclick="ExecuteScraper" disabled="@isExecuting">
                        @if (isExecuting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Scraping & Synthesizing...</span>
                        }
                        else
                        {
                            <span>Execute Edge Scrape ⚡</span>
                        }
                    </button>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger-glass text-xs font-mono mb-0">
                            @errorMessage
                        </div>
                    }

                    <!-- Industry 'Usual Features': History Log -->
                    <div class="mt-3 pt-3 border-top-glass">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted-cyan font-mono text-xs">RECENT SCRAPES</span>
                            @if (recentScrapes.Count > 0)
                            {
                                <button class="btn btn-xs text-danger-glass p-0 font-mono text-xs" @onclick="ClearHistory">Clear</button>
                            }
                        </div>

                        @if (recentScrapes.Count == 0)
                        {
                            <p class="text-muted-cyan text-xs italic mb-0">No recent evaluations recorded.</p>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-1.5" style="max-height: 160px; overflow-y: auto;">
                                @foreach (var item in recentScrapes)
                                {
                                    <div class="p-2 rounded bg-glass-dark border-glass d-flex justify-content-between align-items-center cursor-pointer hover-bright" @onclick="() => LoadFromHistory(item)">
                                        <div class="text-truncate me-2">
                                            <div class="text-white text-xs font-mono text-truncate">@item.Url</div>
                                            <div class="text-muted-cyan text-xxs font-mono">@item.Timestamp</div>
                                        </div>
                                        <span class="badge bg-glass-neon text-cyan text-xxs font-mono">Load</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Results & Viewer -->
            <div class="col-12 col-lg-7">
                <div class="glass-card p-4 h-100 d-flex flex-column">
                    <!-- Results Toolbar -->
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3 pb-2 border-bottom-glass">
                        <div class="d-flex gap-2">
                            <button class="btn btn-xs @(viewTab == "formatted" ? "btn-cyan" : "btn-outline-info border-glass text-muted-cyan") rounded-pill px-3 font-mono text-xs" @onclick='() => viewTab = "formatted"'>
                                Formatted Output
                            </button>
                            <button class="btn btn-xs @(viewTab == "raw" ? "btn-cyan" : "btn-outline-info border-glass text-muted-cyan") rounded-pill px-3 font-mono text-xs" @onclick='() => viewTab = "raw"'>
                                Raw Payload
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(scrapeResult))
                        {
                            <div class="d-flex gap-2">
                                <button class="btn btn-xs btn-outline-info border-glass rounded-pill px-2.5 py-1 text-cyan font-mono text-xs" @onclick="CopyToClipboard">
                                    📋 Copy
                                </button>
                                <button class="btn btn-xs btn-outline-info border-glass rounded-pill px-2.5 py-1 text-cyan font-mono text-xs" @onclick="DownloadResult">
                                    💾 Export
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Viewer Panel -->
                    <div class="flex-grow-1 p-3 rounded bg-glass-dark border-glass font-mono text-xs text-cyan-light overflow-auto" style="min-height: 350px; max-height: 550px; white-space: pre-wrap;">
                        @if (isExecuting)
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center h-100 py-5 gap-3">
                                <div class="spinner-modern"></div>
                                <span class="text-muted-cyan font-mono text-xs">Dispatching request to Cloudflare Edge AI Workers...</span>
                            </div>
                        }
                        else if (string.IsNullOrEmpty(scrapeResult))
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center h-100 py-5 text-center">
                                <span class="display-6 mb-2">⚡</span>
                                <p class="text-white font-mono text-sm mb-1">Inference Scraper Ready</p>
                                <p class="text-muted-cyan font-mono text-xs max-w-300">Enter a target URL on the left and click "Execute Edge Scrape" to evaluate web pages at edge speed.</p>
                            </div>
                        }
                        else
                        {
                            if (viewTab == "formatted")
                            {
                                @scrapeResult
                            }
                            else
                            {
                                @rawJsonResponse
                            }
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(statusNotification))
                    {
                        <div class="mt-2 text-xs font-mono text-green text-center">
                            @statusNotification
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
