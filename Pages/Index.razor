@page "/"
@inject HttpClient Http
@inject IJSRuntime JS

<div class="dashboard-wrapper">
    <div class="glass-bg-glow"></div>
    <canvas id="mesh-background-canvas" class="position-fixed top-0 start-0 w-100 h-100 pe-none" style="z-index: 0; opacity: 0.35;"></canvas>
    
    <div class="container-fluid py-2 px-3 px-md-4 position-relative d-flex flex-column h-100" style="z-index: 1;">
        <!-- Compact Control Bar & View Selector -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2 pb-2 border-bottom-glass flex-shrink-0">
            <div class="d-flex align-items-center gap-2">
                <span class="status-indicator-pill px-2.5 py-1 rounded-pill d-inline-flex align-items-center gap-1.5 bg-glass-dark border-glass">
                    <span class="status-dot @(isZlaMode ? "status-zla" : isLoggedIn ? "status-online" : "status-offline")"></span>
                    <span class="text-xs font-mono">
                        @(isZlaMode ? "ZLA Mode" : isLoggedIn ? "Cloud Synced" : "Offline")
                    </span>
                </span>
                <span class="text-white font-weight-bold text-sm d-none d-sm-inline-block">Personalization Portal</span>
            </div>

            <!-- Tab Buttons -->
            @if (isLoggedIn)
            {
                <div class="d-flex align-items-center gap-1.5 flex-wrap">
                    <button class="btn btn-xs @(activeTab == "services" ? "btn-cyan" : "btn-outline-info border-glass text-muted-cyan") rounded-pill px-3 py-1 font-mono text-xs" @onclick='() => activeTab = "services"'>
                        🌐 Service Hub
                    </button>
                    <button class="btn btn-xs @(activeTab == "settings" ? "btn-cyan" : "btn-outline-info border-glass text-muted-cyan") rounded-pill px-3 py-1 font-mono text-xs" @onclick='() => activeTab = "settings"'>
                        ⚙️ Service Settings & Credentials
                    </button>
                    <button class="btn btn-xs @(activeTab == "billing" ? "btn-cyan" : "btn-outline-info border-glass text-muted-cyan") rounded-pill px-3 py-1 font-mono text-xs" @onclick='() => activeTab = "billing"'>
                        💳 Premium & Credits (@userProfile.Credits.ToString("N0"))
                    </button>
                </div>
            }

            <div class="d-flex align-items-center gap-2">
                <div class="dropdown d-inline-block">
                    <button class="btn btn-xs btn-outline-info border-glass rounded-pill px-2.5 py-1 text-cyan text-xs dropdown-toggle" type="button" id="servicesDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        Connected Services ↗
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark bg-glass-dark border-glass shadow-glass text-xs" aria-labelledby="servicesDropdown">
                        <li><a class="dropdown-menu-item text-white px-3 py-1.5 d-flex align-items-center justify-content-between text-decoration-none" href="https://inspectallamado.dondlingergc.com" target="_blank"><span>Inspect Llamado</span> <span class="badge bg-green text-dark rounded-pill ms-2 text-xxs">Active</span></a></li>
                        <li><a class="dropdown-menu-item text-white px-3 py-1.5 d-flex align-items-center justify-content-between text-decoration-none" href="https://wazweather.dondlingergc.com" target="_blank"><span>WaZWeather</span> <span class="badge bg-green text-dark rounded-pill ms-2 text-xxs">Active</span></a></li>
                        <li><hr class="dropdown-divider border-glass my-1"></li>
                        <li><a class="dropdown-menu-item text-cyan px-3 py-1.5 text-decoration-none font-mono text-xxs" @onclick='() => activeTab = "settings"'>Configure Service Keys →</a></li>
                    </ul>
                </div>
                @if (isLoggedIn)
                {
                    <button class="btn btn-xs btn-outline-danger border-glass rounded-pill px-2.5 py-1 text-xs" @onclick="Logout">
                        Logout
                    </button>
                }
            </div>
        </div>

        @if (!isLoggedIn)
        {
            <!-- Auth Card Viewport-Centered -->
            <div class="row justify-content-center align-items-center flex-grow-1 animate-scale-in my-auto py-2">
                <div class="col-12 col-md-8 col-lg-5">
                    <div class="glass-card shadow-glass p-3 p-md-4">
                        <div class="text-center mb-3">
                            <span class="badge bg-glass-neon text-cyan text-uppercase font-mono text-xs mb-2">Dondlinger Identity Pass</span>
                            <h2 class="h4 text-white mb-1">@(isRegisterMode ? "Create Account" : "Platform Login")</h2>
                            <p class="text-muted-cyan text-xs mb-0">@(isRegisterMode ? "Register cross-app settings, zero-knowledge vault, and edge quotas" : "Sign in to synchronize settings & credentials across all *.dondlingergc.com apps")</p>
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger-glass d-flex align-items-center gap-2 mb-3 py-2 text-xs animate-shake" role="alert">
                                <div>@errorMessage</div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success-glass d-flex align-items-center gap-2 mb-3 py-2 text-xs" role="alert">
                                <div>@successMessage</div>
                            </div>
                        }

                        <EditForm Model="@authModel" OnValidSubmit="HandleAuthSubmit">
                            <DataAnnotationsValidator />
                            
                            <div class="mb-2.5">
                                <label for="email" class="form-label text-muted-cyan font-mono text-xs mb-1">EMAIL ADDRESS</label>
                                <div class="input-glass-group">
                                    <span class="input-icon">📧</span>
                                    <InputText id="email" class="form-control input-glass font-mono text-sm py-1.5" @bind-Value="authModel.Email" placeholder="you@example.com" />
                                </div>
                                <ValidationMessage For="@(() => authModel.Email)" class="text-danger-glass mt-1 text-xs" />
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label text-muted-cyan font-mono text-xs mb-1">PASSWORD</label>
                                <div class="input-glass-group">
                                    <span class="input-icon">🔒</span>
                                    <InputText type="password" id="password" class="form-control input-glass font-mono text-sm py-1.5" @bind-Value="authModel.Password" placeholder="••••••••" />
                                </div>
                                <ValidationMessage For="@(() => authModel.Password)" class="text-danger-glass mt-1 text-xs" />
                            </div>

                            <button type="submit" class="btn btn-cyan btn-glow w-100 py-2 rounded-3 mb-2 font-mono text-sm d-flex align-items-center justify-content-center gap-2" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Authenticating...</span>
                                }
                                else
                                {
                                    <span>@(isRegisterMode ? "Register & Setup Sync" : "Sign In to Account")</span>
                                }
                            </button>

                            <div class="text-center">
                                <button type="button" class="btn btn-link text-cyan font-sans text-xs p-0" @onclick="ToggleAuthMode">
                                    @(isRegisterMode ? "Already have an account? Sign In" : "Need an account? Register Here")
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Authenticated High-Ergonomics Grid Area -->
            <div class="flex-grow-1 overflow-auto animate-scale-in py-1">
                @if (activeTab == "services" || activeTab == "overview")
                {
                    <!-- Connected Services Hub View -->
                    <div class="d-flex flex-column h-100 gap-3">
                        <div class="row g-3">
                            <!-- WaZWeather Card -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="glass-card p-3 h-100 d-flex flex-column justify-content-between border-glass hover-bright position-relative">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <span class="fs-4">🌤️</span>
                                            <span class="badge bg-green text-dark font-mono text-xxs px-2 py-0.5 rounded-pill">ONLINE</span>
                                        </div>
                                        <h4 class="h6 text-white font-weight-bold mb-1">WaZWeather</h4>
                                        <p class="text-muted-cyan text-xs mb-3">Live atmospheric intelligence, radar tracking, & location-based forecasts.</p>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between pt-2 border-top-glass">
                                        <button class="btn btn-xs btn-outline-info border-glass text-cyan text-xs rounded-pill" @onclick='() => activeTab = "settings"'>
                                            ⚙️ Settings
                                        </button>
                                        <a href="https://wazweather.dondlingergc.com" target="_blank" class="btn btn-xs btn-cyan text-dark text-xs font-mono rounded-pill px-3">
                                            Launch App ↗
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Inspect Llamado Card -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="glass-card p-3 h-100 d-flex flex-column justify-content-between border-glass hover-bright position-relative">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <span class="fs-4">📋</span>
                                            <span class="badge bg-green text-dark font-mono text-xxs px-2 py-0.5 rounded-pill">ONLINE</span>
                                        </div>
                                        <h4 class="h6 text-white font-weight-bold mb-1">Inspect Llamado</h4>
                                        <p class="text-muted-cyan text-xs mb-3">Commercial site inspection tool, report generator & photo management software.</p>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between pt-2 border-top-glass">
                                        <button class="btn btn-xs btn-outline-info border-glass text-cyan text-xs rounded-pill" @onclick='() => activeTab = "settings"'>
                                            ⚙️ Settings
                                        </button>
                                        <a href="https://inspectallamado.dondlingergc.com" target="_blank" class="btn btn-xs btn-cyan text-dark text-xs font-mono rounded-pill px-3">
                                            Launch App ↗
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Edge AI Router Card -->
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="glass-card p-3 h-100 d-flex flex-column justify-content-between border-glass hover-bright position-relative">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <span class="fs-4">⚡</span>
                                            <span class="badge bg-glass-neon text-cyan font-mono text-xxs px-2 py-0.5 rounded-pill">PRO ENGINE</span>
                                        </div>
                                        <h4 class="h6 text-white font-weight-bold mb-1">Edge AI Router</h4>
                                        <p class="text-muted-cyan text-xs mb-3">Stateless webpage audit engine powered by Llama 3.3 70B Edge Workers AI.</p>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between pt-2 border-top-glass">
                                        <button class="btn btn-xs btn-outline-info border-glass text-cyan text-xs rounded-pill" @onclick='() => activeTab = "edge"'>
                                            🧪 Open Scraper
                                        </button>
                                        <button class="btn btn-xs btn-cyan text-dark text-xs font-mono rounded-pill px-3" @onclick='() => activeTab = "edge"'>
                                            Run Eval ⚡
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sync Status & Overview Bar -->
                        <div class="glass-card p-3">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <div>
                                    <h4 class="h6 text-white mb-0 font-weight-bold">Single Sign-On & Global Personalization Pass</h4>
                                    <p class="text-muted-cyan text-xs mb-0">Logged in as <strong class="text-white">@userProfile.Email</strong> (@userProfile.Tier Tier). All preferences sync seamlessly across `*.dondlingergc.com`.</p>
                                </div>
                                <button class="btn btn-xs btn-outline-info border-glass text-cyan font-mono text-xs rounded-pill px-3" @onclick='() => activeTab = "billing"'>
                                    Refill Credits / Manage Premium →
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else if (activeTab == "settings" || activeTab == "vault")
                {
                    <!-- Settings & Key Vault View -->
                    <div class="glass-card shadow-glass p-3 p-md-4 h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom-glass pb-2">
                            <div>
                                <h3 class="h6 text-white mb-0 font-sans font-weight-bold">
                                    Connected Service Settings & Key Vault
                                </h3>
                                <p class="text-muted-cyan text-xs mb-0">Configure preferences and retrieve credentials per connected platform service.</p>
                            </div>
                            
                            <div class="form-check form-switch zla-switch font-sans text-xs d-flex align-items-center gap-2">
                                <input class="form-check-input" type="checkbox" role="switch" id="zlaToggle" @bind="isZlaMode" @bind:after="OnZlaModeChanged" />
                                <label class="form-check-label text-warning" for="zlaToggle">
                                    Local Storage Only (ZLA)
                                </label>
                            </div>
                        </div>

                        <div class="row g-3 flex-grow-1 overflow-auto">
                            <!-- WaZWeather Settings -->
                            <div class="col-12 col-md-6">
                                <div class="p-3 bg-glass-dark border-glass rounded h-100">
                                    <h4 class="h6 text-cyan font-mono mb-2">🌤️ WaZWeather Preferences</h4>
                                    <div class="mb-2">
                                        <label class="form-label text-muted-cyan font-sans text-xs mb-1">Measurement Unit</label>
                                        <select class="form-select select-glass font-sans text-xs py-1.5" @bind="userSettings.Unit" @bind:after="OnSettingsChanged">
                                            <option value="imperial">Imperial (°F, mph)</option>
                                            <option value="metric">Metric (°C, m/s)</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="form-label text-muted-cyan font-mono text-xs d-flex justify-content-between mb-1">
                                            <span>DEFAULT REGIONS</span>
                                            <span class="text-cyan">@userSettings.Locations.Count / 5</span>
                                        </label>
                                        <div class="d-flex gap-2 mb-2">
                                            <input type="text" class="form-control input-glass font-mono text-xs py-1.5" placeholder="Add region..." @bind="newLocationInput" @onkeyup="HandleLocationKeyup" />
                                            <button class="btn btn-cyan btn-xs px-3 font-mono" @onclick="AddLocation">Add</button>
                                        </div>
                                        <div class="locations-chip-list">
                                            @foreach (var loc in userSettings.Locations)
                                            {
                                                <span class="location-chip d-inline-flex align-items-center gap-1.5 px-2.5 py-1 rounded-pill font-mono text-xs text-white">
                                                    <span>@loc</span>
                                                    <button type="button" class="btn-remove-chip" @onclick="() => RemoveLocation(loc)">&times;</button>
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Visual & Global System Settings -->
                            <div class="col-12 col-md-6">
                                <div class="p-3 bg-glass-dark border-glass rounded h-100">
                                    <h4 class="h6 text-cyan font-mono mb-2">⚙️ Portal Appearance & API Keys</h4>
                                    <div class="mb-3">
                                        <label class="form-label text-muted-cyan font-sans text-xs mb-1">Visual Theme</label>
                                        <select class="form-select select-glass font-sans text-xs py-1.5" @bind="userSettings.Theme" @bind:after="OnSettingsChanged">
                                            <option value="dark">Dark Neon Theme</option>
                                            <option value="light">Light Glass Theme</option>
                                            <option value="dracula">High Contrast Matrix</option>
                                        </select>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label text-muted-cyan font-mono text-xs mb-1">YOUR SINGLE SIGN-ON JWT PASS</label>
                                        <div class="input-group">
                                            <input type="password" class="form-control input-glass font-mono text-xs py-1.5" value="@jwtToken" readonly />
                                            <button class="btn btn-outline-info border-glass text-cyan text-xs font-mono" @onclick="CopyTokenToClipboard">Copy</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(syncMessage))
                        {
                            <div class="mt-2 alert alert-success-glass py-1.5 px-3 text-xs font-mono text-center mb-0">
                                @syncMessage
                            </div>
                        }
                    </div>
                }
                else if (activeTab == "billing")
                {
                    <!-- Premium Plans & Credit Top-Up Suite -->
                    <div class="glass-card shadow-glass p-3 p-md-4 h-100 d-flex flex-column overflow-auto">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 border-bottom-glass pb-2 gap-2">
                            <div>
                                <h3 class="h6 text-white mb-0 font-sans font-weight-bold">
                                    💳 Subscription Tier & Credit Refill Suite
                                </h3>
                                <p class="text-muted-cyan text-xs mb-0">Manage service tiers, purchase edge compute credits, and inspect billing ledgers.</p>
                            </div>
                            <div class="badge bg-glass-neon text-cyan font-mono text-sm px-3 py-1.5 rounded-pill border-glass">
                                Active Balance: @userProfile.Credits.ToString("N0") Credits
                            </div>
                        </div>

                        <!-- Top-up & Subscription Cards -->
                        <div class="row g-3 mb-4">
                            <!-- Tier Upgrade Card -->
                            <div class="col-12 col-md-4">
                                <div class="p-3 bg-glass-dark border-glass rounded h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <span class="badge bg-cyan text-dark font-mono text-xxs mb-2">TIER UPGRADE</span>
                                        <h4 class="h6 text-white font-weight-bold mb-1">Pro Plan</h4>
                                        <div class="h4 text-cyan font-mono mb-2">$19 <span class="text-xs text-muted-cyan font-sans">/ month</span></div>
                                        <ul class="text-muted-cyan text-xs list-unstyled mb-3 gap-1 d-flex flex-column">
                                            <li>✔ 2,500 Monthly AI Router Credits</li>
                                            <li>✔ Priority Edge Inference Speed</li>
                                            <li>✔ Cross-App Sync Across All Services</li>
                                        </ul>
                                    </div>
                                    <button class="btn btn-cyan btn-glow w-100 font-mono text-xs py-1.5" @onclick='() => UpgradeTier("pro", 2500)' disabled="@(userProfile.Tier == "pro")">
                                        @(userProfile.Tier == "pro" ? "Current Plan" : "Upgrade to Pro")
                                    </button>
                                </div>
                            </div>

                            <!-- Enterprise Tier Card -->
                            <div class="col-12 col-md-4">
                                <div class="p-3 bg-glass-dark border-glass rounded h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <span class="badge bg-glass-neon text-cyan font-mono text-xxs mb-2">ENTERPRISE</span>
                                        <h4 class="h6 text-white font-weight-bold mb-1">Enterprise Tier</h4>
                                        <div class="h4 text-cyan font-mono mb-2">$99 <span class="text-xs text-muted-cyan font-sans">/ month</span></div>
                                        <ul class="text-muted-cyan text-xs list-unstyled mb-3 gap-1 d-flex flex-column">
                                            <li>✔ 15,000 Monthly AI Router Credits</li>
                                            <li>✔ Unlimited Connected Service Keys</li>
                                            <li>✔ Dedicated Durable Object Instance</li>
                                        </ul>
                                    </div>
                                    <button class="btn btn-outline-info border-glass text-cyan w-100 font-mono text-xs py-1.5" @onclick='() => UpgradeTier("enterprise", 15000)' disabled="@(userProfile.Tier == "enterprise")">
                                        @(userProfile.Tier == "enterprise" ? "Current Plan" : "Upgrade to Enterprise")
                                    </button>
                                </div>
                            </div>

                            <!-- Direct Refill Card -->
                            <div class="col-12 col-md-4">
                                <div class="p-3 bg-glass-dark border-glass rounded h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <span class="badge bg-warning text-dark font-mono text-xxs mb-2">INSTANT TOP-UP</span>
                                        <h4 class="h6 text-white font-weight-bold mb-1">Refill Edge Credits</h4>
                                        <p class="text-muted-cyan text-xs mb-2">Add credits directly to your account balance without changing your tier.</p>
                                        <div class="d-flex gap-1.5 mb-2">
                                            <button class="btn btn-xs btn-outline-info border-glass text-white font-mono flex-grow-1" @onclick="() => BuyCredits(500)">+500</button>
                                            <button class="btn btn-xs btn-outline-info border-glass text-white font-mono flex-grow-1" @onclick="() => BuyCredits(2000)">+2,000</button>
                                            <button class="btn btn-xs btn-cyan font-mono text-dark font-weight-bold flex-grow-1" @onclick="() => BuyCredits(10000)">+10,000</button>
                                        </div>
                                    </div>
                                    <div class="text-muted-cyan text-xxs font-mono text-center">Instant Cloudflare D1 Sync</div>
                                </div>
                            </div>
                        </div>

                        <!-- Credit Ledger Table -->
                        <div class="flex-grow-1 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h4 class="h6 text-white mb-0 font-weight-bold">Transaction & Credit History</h4>
                                <button class="btn btn-xs btn-outline-info border-glass text-cyan text-xs font-mono rounded-pill px-2.5" @onclick="LoadCreditHistory">Refresh Ledger</button>
                            </div>
                            
                            @if (creditHistory == null || creditHistory.Count == 0)
                            {
                                <div class="text-muted-cyan text-xs py-3 italic font-sans text-center border-glass-dashed rounded">
                                    No transaction activity logged yet.
                                </div>
                            }
                            else
                            {
                                <div class="credit-ledger-list d-flex flex-column gap-1.5 font-sans text-xs overflow-auto flex-grow-1" style="max-height: 250px;">
                                    @foreach (var tx in creditHistory)
                                    {
                                        <div class="p-2 rounded border-glass d-flex justify-content-between align-items-center bg-glass-dark">
                                            <div class="d-flex flex-column me-2 text-truncate">
                                                <span class="text-white text-truncate font-sans font-weight-bold">@tx.Description</span>
                                                <span class="text-muted-cyan text-xxs">@FormatTimestamp(tx.Created_at)</span>
                                            </div>
                                            <div class="font-weight-bold @(tx.Amount_cents >= 0 ? "text-green" : "text-danger-glass") text-nowrap">
                                                @(tx.Amount_cents >= 0 ? $"+{tx.Amount_cents}" : tx.Amount_cents.ToString())
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (activeTab == "edge")
                {
                    <!-- Edge Router Evaluation View -->
                    <div class="glass-card shadow-glass p-3 p-md-4 h-100 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-2 border-bottom-glass pb-2">
                            <div>
                                <span class="badge bg-glass-neon text-cyan text-uppercase font-mono text-xxs px-2 py-0.5 rounded-pill">Edge Router Engine</span>
                                <h3 class="h6 text-white mb-0 mt-1">Stateless URL Evaluator</h3>
                            </div>
                            <span class="text-xs text-muted-cyan font-mono">Llama 3.3 70B Edge</span>
                        </div>

                        <div class="d-flex gap-2 mb-2">
                            <input type="url" class="form-control input-glass font-mono text-xs py-1.5" placeholder="https://wazweather.dondlingergc.com" @bind="evalTargetUrl" />
                            <button class="btn btn-cyan btn-xs px-3 font-mono text-xs d-flex align-items-center gap-1.5 text-nowrap" @onclick="RunEdgeEvaluation" disabled="@isEvaluating">
                                @if (isEvaluating)
                                {
                                    <span class="spinner-border spinner-border-xs" role="status" aria-hidden="true"></span>
                                    <span>Evaluating...</span>
                                }
                                else
                                {
                                    <span>Run Eval ⚡</span>
                                }
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(evalError))
                        {
                            <div class="alert alert-danger-glass text-xs font-mono mb-2 py-1 px-2">
                                @evalError
                            </div>
                        }

                        <div class="eval-result-card p-3 rounded bg-glass-dark border-glass font-mono text-xs text-cyan-light flex-grow-1 overflow-auto" style="white-space: pre-wrap; max-height: 420px;">
                            @(string.IsNullOrEmpty(evalResult) ? "Enter a target URL above and click Run Eval to execute an architectural assessment." : evalResult)
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
