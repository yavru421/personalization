@page "/"
@inject HttpClient Http
@inject IJSRuntime JS

<div class="dashboard-wrapper">
    <div class="glass-bg-glow"></div>
    <canvas id="mesh-background-canvas" class="position-fixed top-0 start-0 w-100 h-100 pe-none" style="z-index: 0; opacity: 0.35;"></canvas>
    
    <div class="container-fluid py-2 px-3 px-md-4 position-relative d-flex flex-column h-100" style="z-index: 1;">
        <!-- Compact Control Bar & View Selector -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2 pb-2 border-bottom-glass flex-shrink-0">
            <div class="d-flex align-items-center gap-2">
                <span class="status-indicator-pill px-2.5 py-1 rounded-pill d-inline-flex align-items-center gap-1.5 bg-glass-dark border-glass">
                    <span class="status-dot @(isZlaMode ? "status-zla" : isLoggedIn ? "status-online" : "status-offline")"></span>
                    <span class="text-xs font-mono">
                        @(isZlaMode ? "ZLA Mode" : isLoggedIn ? "Cloud Synced" : "Offline")
                    </span>
                </span>
                <span class="text-white font-weight-bold text-sm d-none d-sm-inline-block">Personalization Portal</span>
            </div>

            <!-- Tab Buttons -->
            @if (isLoggedIn)
            {
                <div class="d-flex align-items-center gap-1.5 flex-wrap">
                    <button class="btn btn-xs @(activeTab == "overview" ? "btn-cyan" : "btn-outline-info border-glass text-muted-cyan") rounded-pill px-3 py-1 font-mono text-xs" @onclick='() => activeTab = "overview"'>
                        📊 Overview
                    </button>
                    <button class="btn btn-xs @(activeTab == "vault" ? "btn-cyan" : "btn-outline-info border-glass text-muted-cyan") rounded-pill px-3 py-1 font-mono text-xs" @onclick='() => activeTab = "vault"'>
                        🔐 Vault & Sync
                    </button>
                    <button class="btn btn-xs @(activeTab == "edge" ? "btn-cyan" : "btn-outline-info border-glass text-muted-cyan") rounded-pill px-3 py-1 font-mono text-xs" @onclick='() => activeTab = "edge"'>
                        ⚡ Edge Router
                    </button>
                </div>
            }

            <div class="d-flex align-items-center gap-2">
                <a href="/scraper" class="btn btn-xs btn-cyan border-glass rounded-pill px-2.5 py-1 text-dark text-decoration-none font-mono font-weight-bold text-xs">
                    ⚡ Scraper
                </a>
                <a href="https://inspectallamado.dondlingergc.com" target="_blank" class="btn btn-xs btn-outline-info border-glass rounded-pill px-2.5 py-1 text-cyan text-decoration-none text-xs">
                    Inspect Llamado ↗
                </a>
                <a href="https://wazweather.dondlingergc.com" target="_blank" class="btn btn-xs btn-outline-info border-glass rounded-pill px-2.5 py-1 text-cyan text-decoration-none text-xs">
                    WaZWeather ↗
                </a>
                @if (isLoggedIn)
                {
                    <button class="btn btn-xs btn-outline-danger border-glass rounded-pill px-2.5 py-1 text-xs" @onclick="Logout">
                        Logout
                    </button>
                }
            </div>
        </div>

        @if (!isLoggedIn)
        {
            <!-- Auth Card Viewport-Centered -->
            <div class="row justify-content-center align-items-center flex-grow-1 animate-scale-in my-auto py-2">
                <div class="col-12 col-md-8 col-lg-5">
                    <div class="glass-card shadow-glass p-3 p-md-4">
                        <div class="text-center mb-3">
                            <span class="badge bg-glass-neon text-cyan text-uppercase font-mono text-xs mb-2">Dondlinger Identity Pass</span>
                            <h2 class="h4 text-white mb-1">@(isRegisterMode ? "Create Account" : "Platform Login")</h2>
                            <p class="text-muted-cyan text-xs mb-0">@(isRegisterMode ? "Register cross-app settings, zero-knowledge vault, and edge quotas" : "Sign in to synchronize settings & credentials across all *.dondlingergc.com apps")</p>
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger-glass d-flex align-items-center gap-2 mb-3 py-2 text-xs animate-shake" role="alert">
                                <div>@errorMessage</div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success-glass d-flex align-items-center gap-2 mb-3 py-2 text-xs" role="alert">
                                <div>@successMessage</div>
                            </div>
                        }

                        <EditForm Model="@authModel" OnValidSubmit="HandleAuthSubmit">
                            <DataAnnotationsValidator />
                            
                            <div class="mb-2.5">
                                <label for="email" class="form-label text-muted-cyan font-mono text-xs mb-1">EMAIL ADDRESS</label>
                                <div class="input-glass-group">
                                    <span class="input-icon">📧</span>
                                    <InputText id="email" class="form-control input-glass font-mono text-sm py-1.5" @bind-Value="authModel.Email" placeholder="you@example.com" />
                                </div>
                                <ValidationMessage For="@(() => authModel.Email)" class="text-danger-glass mt-1 text-xs" />
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label text-muted-cyan font-mono text-xs mb-1">PASSWORD</label>
                                <div class="input-glass-group">
                                    <span class="input-icon">🔒</span>
                                    <InputText type="password" id="password" class="form-control input-glass font-mono text-sm py-1.5" @bind-Value="authModel.Password" placeholder="••••••••" />
                                </div>
                                <ValidationMessage For="@(() => authModel.Password)" class="text-danger-glass mt-1 text-xs" />
                            </div>

                            <button type="submit" class="btn btn-cyan btn-glow w-100 py-2 rounded-3 mb-2 font-mono text-sm d-flex align-items-center justify-content-center gap-2" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Authenticating...</span>
                                }
                                else
                                {
                                    <span>@(isRegisterMode ? "Register & Setup Sync" : "Sign In to Account")</span>
                                }
                            </button>

                            <div class="text-center">
                                <button type="button" class="btn btn-link text-cyan font-sans text-xs p-0" @onclick="ToggleAuthMode">
                                    @(isRegisterMode ? "Already have an account? Sign In" : "Need an account? Register Here")
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Authenticated High-Ergonomics Grid Area -->
            <div class="flex-grow-1 overflow-auto animate-scale-in py-1">
                @if (activeTab == "overview")
                {
                    <div class="row g-3 h-100">
                        <!-- Profile Card -->
                        <div class="col-12 col-md-5 d-flex flex-column">
                            <div class="glass-card shadow-glass p-3 h-100">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h3 class="h6 text-white mb-0 font-sans font-weight-bold">
                                        👤 Sync Profile
                                    </h3>
                                    <span class="badge bg-cyan text-dark rounded-pill font-sans text-xs px-2.5 py-1">@userProfile.Tier</span>
                                </div>
                                
                                <div class="profile-grid font-sans text-sm gap-2">
                                    <div class="profile-label text-muted-cyan">ACCOUNT:</div>
                                    <div class="profile-value text-white text-truncate font-weight-bold">@userProfile.Email</div>
                                    
                                    <div class="profile-label text-muted-cyan">MODE:</div>
                                    <div class="profile-value @(isZlaMode ? "text-warning" : "text-green")">
                                        @(isZlaMode ? "Zero Liability (Local)" : "Cloud Authenticated")
                                    </div>
                                    
                                    <div class="profile-label text-muted-cyan">CREDITS:</div>
                                    <div class="profile-value text-cyan font-weight-bold">@userProfile.Credits.ToString("N0") units</div>
                                </div>

                                <hr class="border-glass my-3" />

                                <div class="text-muted-cyan text-xs font-sans">
                                    Your profile settings automatically sync across all platform services and endpoints.
                                </div>
                            </div>
                        </div>

                        <!-- Credit History Audit Panel -->
                        <div class="col-12 col-md-7 d-flex flex-column">
                            <div class="glass-card shadow-glass p-3 h-100 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-center mb-2 flex-shrink-0">
                                    <h3 class="h6 text-white mb-0 font-sans font-weight-bold">
                                        Credit History & Activity
                                    </h3>
                                    <button class="btn btn-xs btn-outline-info border-glass rounded-pill px-2.5 py-0.5 text-xs font-sans" @onclick="LoadCreditHistory" disabled="@isLoadingCreditHistory">
                                        @if (isLoadingCreditHistory)
                                        {
                                            <span class="spinner-border spinner-border-xs" role="status" aria-hidden="true"></span>
                                        }
                                        else
                                        {
                                            <span>Refresh</span>
                                        }
                                    </button>
                                </div>

                                @if (isLoadingCreditHistory)
                                {
                                    <div class="text-center py-4 text-muted-cyan font-sans text-xs my-auto">
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        Loading audit log...
                                    </div>
                                }
                                else if (creditHistory == null || creditHistory.Count == 0)
                                {
                                    <div class="text-muted-cyan text-xs py-4 italic font-sans text-center border-glass-dashed rounded my-auto">
                                        No transaction activity yet.
                                    </div>
                                }
                                else
                                {
                                    <div class="credit-ledger-list d-flex flex-column gap-1.5 font-sans text-xs overflow-auto flex-grow-1 pr-1" style="max-height: 380px;">
                                        @foreach (var tx in creditHistory)
                                        {
                                            <div class="p-2 rounded border-glass d-flex justify-content-between align-items-center bg-glass-dark">
                                                <div class="d-flex flex-column me-2 text-truncate">
                                                    <span class="text-white text-truncate font-sans font-weight-bold">@tx.Description</span>
                                                    <span class="text-muted-cyan text-xxs">@FormatTimestamp(tx.Created_at)</span>
                                                </div>
                                                <div class="font-weight-bold @(tx.Amount_cents >= 0 ? "text-green" : "text-danger-glass") text-nowrap">
                                                    @(tx.Amount_cents >= 0 ? $"+{tx.Amount_cents}" : tx.Amount_cents.ToString())
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (activeTab == "vault")
                {
                    <!-- Settings & Key Vault View -->
                    <div class="glass-card shadow-glass p-3 p-md-4 h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom-glass pb-2">
                            <h3 class="h6 text-white mb-0 font-sans font-weight-bold">
                                Settings & Preferences
                            </h3>
                            
                            <div class="form-check form-switch zla-switch font-sans text-xs d-flex align-items-center gap-2">
                                <input class="form-check-input" type="checkbox" role="switch" id="zlaToggle" @bind="isZlaMode" @bind:after="OnZlaModeChanged" />
                                <label class="form-check-label text-warning" for="zlaToggle">
                                    Local Storage Only (ZLA)
                                </label>
                            </div>
                        </div>

                        <div class="row g-3 flex-grow-1">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted-cyan font-sans text-xs mb-1">Visual Theme</label>
                                <select class="form-select select-glass font-sans text-xs py-1.5" @bind="userSettings.Theme" @bind:after="OnSettingsChanged">
                                    <option value="dark">Dark Theme</option>
                                    <option value="light">Light Theme</option>
                                    <option value="dracula">High Contrast Theme</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted-cyan font-sans text-xs mb-1">Measurement Unit</label>
                                <select class="form-select select-glass font-sans text-xs py-1.5" @bind="userSettings.Unit" @bind:after="OnSettingsChanged">
                                    <option value="imperial">Imperial (°F, mph)</option>
                                    <option value="metric">Metric (°C, m/s)</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label text-muted-cyan font-mono text-xs d-flex justify-content-between mb-1">
                                    <span>MONITORED REGIONS</span>
                                    <span class="text-cyan">@userSettings.Locations.Count / 5</span>
                                </label>
                                
                                <div class="d-flex gap-2 mb-2">
                                    <input type="text" class="form-control input-glass font-mono text-xs py-1.5" placeholder="Add location (e.g. Wichita, KS)..." @bind="newLocationInput" @onkeyup="HandleLocationKeyup" />
                                    <button class="btn btn-cyan btn-xs px-3 font-mono" @onclick="AddLocation">Add</button>
                                </div>

                                <div class="locations-chip-list">
                                    @if (userSettings.Locations == null || userSettings.Locations.Count == 0)
                                    {
                                        <div class="text-muted-cyan text-xs py-2 italic font-sans text-center border-glass-dashed rounded">
                                            No locations configured.
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var loc in userSettings.Locations)
                                        {
                                            <span class="location-chip d-inline-flex align-items-center gap-1.5 px-2.5 py-1 rounded-pill font-mono text-xs text-white">
                                                <span>@loc</span>
                                                <button type="button" class="btn-remove-chip" @onclick="() => RemoveLocation(loc)">&times;</button>
                                            </span>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(syncMessage))
                        {
                            <div class="mt-2 alert alert-success-glass py-1.5 px-3 text-xs font-mono text-center mb-0">
                                @syncMessage
                            </div>
                        }
                    </div>
                }
                else if (activeTab == "edge")
                {
                    <!-- Edge Router Evaluation View -->
                    <div class="glass-card shadow-glass p-3 p-md-4 h-100 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-2 border-bottom-glass pb-2">
                            <div>
                                <span class="badge bg-glass-neon text-cyan text-uppercase font-mono text-xxs px-2 py-0.5 rounded-pill">Edge Router Engine</span>
                                <h3 class="h6 text-white mb-0 mt-1">Stateless URL Evaluator</h3>
                            </div>
                            <span class="text-xs text-muted-cyan font-mono">Llama 3.3 70B Edge</span>
                        </div>

                        <div class="d-flex gap-2 mb-2">
                            <input type="url" class="form-control input-glass font-mono text-xs py-1.5" placeholder="https://wazweather.dondlingergc.com" @bind="evalTargetUrl" />
                            <button class="btn btn-cyan btn-xs px-3 font-mono text-xs d-flex align-items-center gap-1.5 text-nowrap" @onclick="RunEdgeEvaluation" disabled="@isEvaluating">
                                @if (isEvaluating)
                                {
                                    <span class="spinner-border spinner-border-xs" role="status" aria-hidden="true"></span>
                                    <span>Evaluating...</span>
                                }
                                else
                                {
                                    <span>Run Eval ⚡</span>
                                }
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(evalError))
                        {
                            <div class="alert alert-danger-glass text-xs font-mono mb-2 py-1 px-2">
                                @evalError
                            </div>
                        }

                        <div class="eval-result-card p-3 rounded bg-glass-dark border-glass font-mono text-xs text-cyan-light flex-grow-1 overflow-auto" style="white-space: pre-wrap; max-height: 420px;">
                            @(string.IsNullOrEmpty(evalResult) ? "Enter a target URL above and click Run Eval to execute an architectural assessment." : evalResult)
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
